  "cards": [
    {
      "dot": "violet",
      "title": "Surfaces, not markup",
      "items": [
        "The agent sends components and a data model",
        "The renderer draws them with the site's own form controls",
        "Only the basic catalogue is allowed through"
      ]
    },
    {
      "dot": "cyan",
      "title": "Actions carry the data",
      "items": [
        "A submitted form is an action with a2uiClientDataModel",
        "The binding stores both on the surface",
        "The answer is another surface update"
      ]
    },
    {
      "dot": "slate",
      "title": "Lifecycle",
      "items": [
        "createSurface opens a surface",
        "updateComponents and updateDataModel change it",
        "deleteSurface ends it"
      ]
    }
