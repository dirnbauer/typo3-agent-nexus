{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "A2UI v0.9.1: a generated form, an action and a confirmation",
    "locale": "en",
    "column_fit": "spread",
    "animation": "trace",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "intent",
        "label": "Describe the need",
        "focus": [
          "visitor",
          "renderer",
          "binding",
          "agent"
        ],
        "note": "One sentence becomes a surface request with the client's version and capabilities."
      },
      {
        "id": "surface",
        "label": "Draw the surface",
        "focus": [
          "agent",
          "binding",
          "renderer"
        ],
        "note": "The agent answers with components and a data model; the binding sanitises them before they reach the page."
      },
      {
        "id": "action",
        "label": "Send the form",
        "focus": [
          "visitor",
          "renderer",
          "binding"
        ],
        "note": "The filled form goes back as an action with its data model, and a confirmation surface replaces it."
      },
      {
        "id": "discard",
        "label": "Start over",
        "focus": [
          "visitor",
          "renderer",
          "binding"
        ],
        "note": "A discard action removes the surface."
      }
    ],
    "viewBox": [
