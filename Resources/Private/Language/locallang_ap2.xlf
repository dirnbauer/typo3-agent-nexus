    <unit id="roledesc.trusted-surface">
      <segment>
        <source>Shows the mandate to the person and signs it once they approve. Must not be an AI agent.</source>
      </segment>
    </unit>
    <unit id="roledesc.shopping-agent">
      <segment>
        <source>Shops for the person and closes open mandates with its own key. Every other role treats it as untrusted.</source>
      </segment>
    </unit>
