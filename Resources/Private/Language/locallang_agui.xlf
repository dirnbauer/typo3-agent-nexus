    <unit id="event.RUN_STARTED">
      <segment>
        <source>Opens a run and declares the producer's own protocol version.</source>
      </segment>
    </unit>
    <unit id="event.RUN_FINISHED">
      <segment>
        <source>Closes a run that did not fail: success, interrupt or cancelled.</source>
      </segment>
    </unit>
    <unit id="event.RUN_ERROR">
      <segment>
        <source>Ends a run that failed. Only a new run may follow.</source>
      </segment>
    </unit>
    <unit id="event.STEP_STARTED">
      <segment>
        <source>Opens a named phase of the run.</source>
      </segment>
    </unit>
    <unit id="event.STEP_FINISHED">
      <segment>
        <source>Closes the phase with that name.</source>
      </segment>
    </unit>
    <unit id="event.TEXT_MESSAGE_START">
      <segment>
        <source>Opens a message. Without a role, it comes from the assistant.</source>
      </segment>
    </unit>
    <unit id="event.TEXT_MESSAGE_CONTENT">
      <segment>
        <source>Adds text to an open message.</source>
      </segment>
    </unit>
    <unit id="event.TEXT_MESSAGE_END">
      <segment>
        <source>Closes the message.</source>
      </segment>
    </unit>
    <unit id="event.TEXT_MESSAGE_CHUNK">
      <segment>
        <source>Short form of start, content and end. The first chunk carries the messageId.</source>
      </segment>
    </unit>
    <unit id="event.TOOL_CALL_START">
      <segment>
        <source>Opens a tool call, optionally attached to its message.</source>
      </segment>
    </unit>
    <unit id="event.TOOL_CALL_ARGS">
      <segment>
        <source>Adds text to the call's arguments, usually JSON.</source>
      </segment>
    </unit>
    <unit id="event.TOOL_CALL_END">
      <segment>
        <source>Closes the call. Its arguments are complete.</source>
      </segment>
    </unit>
    <unit id="event.TOOL_CALL_CHUNK">
      <segment>
        <source>Short form of a tool call. The first chunk carries the id and the name.</source>
      </segment>
    </unit>
    <unit id="event.TOOL_CALL_RESULT">
      <segment>
        <source>The result of a call, as a new tool message.</source>
      </segment>
    </unit>
    <unit id="event.REASONING_START">
      <segment>
        <source>Opens a reasoning span. Its id names the span only.</source>
      </segment>
    </unit>
    <unit id="event.REASONING_MESSAGE_START">
      <segment>
        <source>Opens a reasoning message with the role reasoning.</source>
      </segment>
    </unit>
    <unit id="event.REASONING_MESSAGE_CONTENT">
      <segment>
        <source>Adds text to an open reasoning message.</source>
      </segment>
    </unit>
    <unit id="event.REASONING_MESSAGE_END">
      <segment>
        <source>Closes the reasoning message.</source>
      </segment>
    </unit>
    <unit id="event.REASONING_MESSAGE_CHUNK">
      <segment>
        <source>Short form of a reasoning message.</source>
      </segment>
    </unit>
    <unit id="event.REASONING_END">
      <segment>
        <source>Closes the reasoning span.</source>
      </segment>
    </unit>
    <unit id="event.REASONING_ENCRYPTED_VALUE">
      <segment>
        <source>Reasoning the provider keeps private. The client stores it and sends it back unread.</source>
      </segment>
    </unit>
    <unit id="event.STATE_SNAPSHOT">
      <segment>
        <source>Replaces the shared state.</source>
      </segment>
    </unit>
    <unit id="event.STATE_DELTA">
      <segment>
        <source>Changes the shared state with a JSON Patch.</source>
      </segment>
    </unit>
    <unit id="event.MESSAGES_SNAPSHOT">
      <segment>
        <source>Restates the conversation. Messages are matched by id.</source>
      </segment>
    </unit>
    <unit id="event.ACTIVITY_SNAPSHOT">
      <segment>
        <source>Creates or replaces an activity: structured progress the page shows as its own element.</source>
      </segment>
    </unit>
    <unit id="event.ACTIVITY_DELTA">
      <segment>
        <source>Changes an activity with a JSON Patch.</source>
      </segment>
    </unit>
    <unit id="event.SUBAGENT_STARTED">
      <segment>
        <source>Announces one invocation of a subagent.</source>
      </segment>
    </unit>
    <unit id="event.SUBAGENT_FINISHED">
      <segment>
        <source>Closes the invocation: success, or suspended for an interrupt.</source>
      </segment>
    </unit>
    <unit id="event.SUBAGENT_ERROR">
      <segment>
        <source>The invocation failed. The run can go on.</source>
      </segment>
    </unit>
    <unit id="event.RAW">
      <segment>
        <source>A provider's own event, passed through unchanged.</source>
      </segment>
    </unit>
    <unit id="event.CUSTOM">
      <segment>
        <source>An application's own event. Its name carries a vendor prefix.</source>
      </segment>
    </unit>
    <unit id="rule.closed-objects">
      <segment>
        <source>Every event is one the schema describes: declared fields only, optional fields left out instead of null, integer timestamps.</source>
      </segment>
    </unit>
    <unit id="rule.first-event">
      <segment>
        <source>A stream starts with RUN_STARTED or RUN_ERROR.</source>
      </segment>
    </unit>
    <unit id="rule.one-active-run">
      <segment>
        <source>There is no RUN_STARTED while a run is active.</source>
      </segment>
    </unit>
    <unit id="rule.closed-run">
      <segment>
        <source>After RUN_FINISHED only RUN_STARTED or a late RUN_ERROR may follow.</source>
      </segment>
    </unit>
    <unit id="rule.failed-run">
      <segment>
        <source>After RUN_ERROR only RUN_STARTED may follow.</source>
      </segment>
    </unit>
    <unit id="rule.terminal-event">
      <segment>
        <source>A stream ends with RUN_FINISHED or RUN_ERROR, also when something fails.</source>
      </segment>
    </unit>
    <unit id="rule.run-identity">
      <segment>
        <source>RUN_STARTED and RUN_FINISHED carry the input's threadId and runId. A run id is never used twice.</source>
      </segment>
    </unit>
    <unit id="rule.protocol-version">
      <segment>
        <source>RUN_STARTED declares the producer's own version, 1.0.</source>
      </segment>
    </unit>
    <unit id="rule.no-double-open">
      <segment>
        <source>A message, tool call, reasoning span or step is not opened again while it is open.</source>
      </segment>
    </unit>
    <unit id="rule.open-before-continue">
      <segment>
        <source>Content, argument and end events only follow an open start.</source>
      </segment>
    </unit>
    <unit id="rule.steps-balanced">
      <segment>
        <source>Every step that starts also finishes, matched by name.</source>
      </segment>
    </unit>
    <unit id="rule.reasoning-namespaces">
      <segment>
        <source>Reasoning spans and reasoning messages have separate ids. A span's id does not open a message.</source>
      </segment>
    </unit>
    <unit id="rule.closed-before-finish">
      <segment>
        <source>Nothing is open at RUN_FINISHED: no step, message, tool call, reasoning span or subagent.</source>
      </segment>
    </unit>
    <unit id="rule.unique-message-ids">
      <segment>
        <source>A messageId names one message in the thread.</source>
      </segment>
    </unit>
    <unit id="rule.activity-baseline">
      <segment>
        <source>ACTIVITY_DELTA only follows an ACTIVITY_SNAPSHOT for the same activity.</source>
      </segment>
    </unit>
    <unit id="rule.chunk-form">
      <segment>
        <source>The first chunk carries its ids. A later chunk does not contradict it. One item does not mix chunks and start events.</source>
      </segment>
    </unit>
    <unit id="rule.subagent-lifecycle">
      <segment>
        <source>A subagent is announced before its work, is never reused and finishes before the run does.</source>
      </segment>
    </unit>
    <unit id="rule.attribution">
      <segment>
        <source>An event that continues an item agrees with the owner that opened it.</source>
      </segment>
    </unit>
    <unit id="rule.outcome">
      <segment>
        <source>An interrupt outcome has at least one interrupt, each with its own id. Pending tool calls match the stream.</source>
      </segment>
    </unit>
