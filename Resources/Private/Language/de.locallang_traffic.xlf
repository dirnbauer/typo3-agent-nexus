      <segment state="final">
        <source>Traffic</source>
        <target>Datenverkehr</target>
      </segment>
    </unit>
    <unit id="list.lede">
      <segment state="final">
        <source>Every request, response and streamed event of the protocol endpoints on this installation, newest first.</source>
        <target>Jede Anfrage, Antwort und jedes gestreamte Ereignis der Protokoll-Endpunkte dieser Installation, das neueste zuerst.</target>
      </segment>
    </unit>
    <unit id="list.recordingOff.title">
      <segment state="final">
        <source>Recording is off</source>
        <target>Die Aufzeichnung ist ausgeschaltet</target>
      </segment>
    </unit>
    <unit id="list.recordingOff.message">
      <segment state="final">
        <source>Turn on "Record the traffic log" in the extension configuration to see new exchanges here.</source>
        <target>Schalten Sie „Record the traffic log“ in der Extension-Konfiguration ein, um neue Anfragen hier zu sehen.</target>
      </segment>
    </unit>
    <unit id="list.bodiesOn">
      <segment state="final">
        <source>Request and response bodies are recorded.</source>
        <target>Anfrage- und Antwortinhalte werden aufgezeichnet.</target>
      </segment>
    </unit>
    <unit id="list.bodiesOff">
      <segment state="final">
        <source>Only method, path, status, timing and headers are recorded.</source>
        <target>Nur Methode, Pfad, Status, Dauer und Header werden aufgezeichnet.</target>
      </segment>
    </unit>
    <unit id="list.redactOn">
      <segment state="final">
        <source>Names, email addresses, phone numbers and addresses are masked before they are stored.</source>
        <target>Namen, E-Mail-Adressen, Telefonnummern und Anschriften werden vor dem Speichern maskiert.</target>
      </segment>
    </unit>
    <unit id="list.redactOff">
      <segment state="final">
        <source>Personal data is stored as it was sent.</source>
        <target>Personenbezogene Daten werden so gespeichert, wie sie gesendet wurden.</target>
      </segment>
    </unit>
    <unit id="list.retention">
