            <segment state="final">
                <source>{count, plural, =0 {no runs} one {# run} other {# runs}}</source>
                <target>{count, plural, =0 {keine Ausführungen} one {# Ausführung} other {# Ausführungen}}</target>
            </segment>
        </unit>
    </file>
</xliff>
