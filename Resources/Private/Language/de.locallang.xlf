<xliff version="2.0" srcLang="en" trgLang="de" xmlns="urn:oasis:names:tc:xliff:document:2.0">
    <file id="messages" original="messages">
        <!-- ICU plural: LLM generation runs shown per month on the A2UI dashboard -->
