        <target>Händlerprofil</target>
      </segment>
    </unit>
    <unit id="ucp.profile.short_description">
      <segment state="final">
        <source>Profile and catalogue</source>
        <target>Profil und Katalog</target>
      </segment>
    </unit>
    <unit id="ucp.profile.description">
      <segment state="final">
        <source>The published UCP business profile, its capabilities and the product catalogue.</source>
        <target>Das veröffentlichte UCP-Händlerprofil, seine Fähigkeiten und der Produktkatalog.</target>
      </segment>
    </unit>
    <unit id="ap2.title">
      <segment state="final">
        <source>AP2</source>
        <target>AP2</target>
      </segment>
    </unit>
    <unit id="ap2.short_description">
      <segment state="final">
        <source>Agent to payment</source>
        <target>Agent zu Zahlung</target>
      </segment>
    </unit>
    <unit id="ap2.description">
      <segment state="final">
        <source>Signed mandates prove that a person approved this purchase, within limits they set.</source>
        <target>Signierte Mandate belegen, dass ein Mensch diesen Kauf innerhalb seiner Grenzen freigegeben hat.</target>
      </segment>
    </unit>
    <unit id="ap2.studio.title">
      <segment state="final">
        <source>Mandate studio</source>
        <target>Mandats-Studio</target>
      </segment>
    </unit>
