    <unit id="main.title">
      <segment state="final">
        <source>Agent Nexus</source>
        <target>Agent Nexus</target>
      </segment>
    </unit>
    <unit id="main.short_description">
      <segment state="final">
        <source>Agent protocols</source>
        <target>Agenten-Protokolle</target>
      </segment>
    </unit>
    <unit id="main.description">
      <segment state="final">
        <source>Five agent protocols running against this installation: A2UI, AG-UI, A2A, UCP and AP2.</source>
        <target>Fünf Agenten-Protokolle, die auf dieser Installation laufen: A2UI, AG-UI, A2A, UCP und AP2.</target>
      </segment>
    </unit>
    <unit id="overview.title">
      <segment state="final">
        <source>Overview</source>
        <target>Übersicht</target>
      </segment>
    </unit>
    <unit id="overview.short_description">
      <segment state="final">
        <source>What runs here</source>
        <target>Was hier läuft</target>
      </segment>
    </unit>
    <unit id="overview.description">
      <segment state="final">
        <source>Which protocols are ready, which specification versions they implement, and what ran recently.</source>
        <target>Welche Protokolle bereit sind, welche Spezifikationsversionen sie umsetzen und was zuletzt gelaufen ist.</target>
      </segment>
    </unit>
    <unit id="a2ui.title">
      <segment state="final">
        <source>A2UI</source>
        <target>A2UI</target>
      </segment>
    </unit>
    <unit id="a2ui.short_description">
      <segment state="final">
        <source>Agent to interface</source>
        <target>Agent zu Oberfläche</target>
      </segment>
    </unit>
    <unit id="a2ui.description">
      <segment state="final">
        <source>An agent describes a form as data; the site renders it from a fixed component catalogue.</source>
        <target>Ein Agent beschreibt ein Formular als Daten; die Website rendert es aus einem festen Komponentenkatalog.</target>
      </segment>
    </unit>
    <unit id="a2ui.playground.title">
      <segment state="final">
        <source>Playground</source>
        <target>Playground</target>
      </segment>
    </unit>
    <unit id="a2ui.playground.short_description">
      <segment state="final">
        <source>Generate a surface</source>
        <target>Oberfläche erzeugen</target>
      </segment>
    </unit>
    <unit id="a2ui.playground.description">
      <segment state="final">
        <source>Describe a form, let the agent build the A2UI messages and fill it in.</source>
        <target>Ein Formular beschreiben, den Agenten die A2UI-Nachrichten bauen lassen und es ausfüllen.</target>
      </segment>
    </unit>
    <unit id="a2ui.catalog.title">
      <segment state="final">
        <source>Component catalogue</source>
        <target>Komponentenkatalog</target>
      </segment>
    </unit>
    <unit id="a2ui.catalog.short_description">
      <segment state="final">
        <source>The trusted components</source>
        <target>Die erlaubten Komponenten</target>
      </segment>
    </unit>
    <unit id="a2ui.catalog.description">
      <segment state="final">
        <source>The basic catalogue this site renders, with every allowed property.</source>
        <target>Der Basiskatalog, den diese Website rendert, mit allen erlaubten Eigenschaften.</target>
      </segment>
    </unit>
    <unit id="agui.title">
      <segment state="final">
        <source>AG-UI</source>
        <target>AG-UI</target>
      </segment>
    </unit>
    <unit id="agui.short_description">
      <segment state="final">
        <source>Agent to user</source>
        <target>Agent zu Mensch</target>
      </segment>
    </unit>
    <unit id="agui.description">
      <segment state="final">
        <source>An agent run streams as typed events and stops for a person's approval before it writes.</source>
        <target>Ein Agentenlauf wird als typisierte Ereignisse gestreamt und hält vor dem Schreiben für eine Freigabe an.</target>
      </segment>
    </unit>
    <unit id="agui.console.title">
      <segment state="final">
        <source>Run console</source>
        <target>Lauf-Konsole</target>
      </segment>
    </unit>
    <unit id="agui.console.short_description">
      <segment state="final">
        <source>Start and approve runs</source>
        <target>Läufe starten und freigeben</target>
      </segment>
    </unit>
    <unit id="agui.console.description">
      <segment state="final">
        <source>Start an agent run, watch its events arrive and answer its interrupt.</source>
        <target>Einen Agentenlauf starten, die Ereignisse verfolgen und die Unterbrechung beantworten.</target>
      </segment>
    </unit>
    <unit id="agui.events.title">
      <segment state="final">
        <source>Event reference</source>
        <target>Ereignis-Referenz</target>
      </segment>
    </unit>
