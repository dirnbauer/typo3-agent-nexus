      <segment state="final">
        <source>A shopping agent checks out through the merchant's UCP API; a person approves before the order is placed.</source>
        <target>Ein Shopping-Agent kauft über die UCP-Schnittstelle des Händlers ein; ein Mensch gibt vor der Bestellung frei.</target>
      </segment>
    </unit>
    <unit id="ucp.console.title">
      <segment state="final">
        <source>Checkout console</source>
        <target>Checkout-Konsole</target>
      </segment>
    </unit>
    <unit id="ucp.console.short_description">
      <segment state="final">
        <source>Run an agent checkout</source>
        <target>Einen Agenten-Checkout ausführen</target>
      </segment>
    </unit>
    <unit id="ucp.console.description">
      <segment state="final">
        <source>Let the shopping agent build a checkout session and approve it.</source>
        <target>Den Shopping-Agenten eine Checkout-Session aufbauen lassen und sie freigeben.</target>
      </segment>
    </unit>
    <unit id="ucp.profile.title">
      <segment state="final">
