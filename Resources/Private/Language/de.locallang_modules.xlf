      <segment state="final">
        <source>Every AG-UI event</source>
        <target>Alle AG-UI-Ereignisse</target>
      </segment>
    </unit>
    <unit id="agui.events.description">
      <segment state="final">
        <source>The AG-UI 1.0 event types with their fields and ordering rules.</source>
        <target>Die Ereignistypen von AG-UI 1.0 mit ihren Feldern und Reihenfolgeregeln.</target>
      </segment>
    </unit>
    <unit id="a2a.title">
      <segment state="final">
        <source>A2A</source>
        <target>A2A</target>
      </segment>
    </unit>
    <unit id="a2a.short_description">
      <segment state="final">
        <source>Agent to agent</source>
        <target>Agent zu Agent</target>
      </segment>
    </unit>
    <unit id="a2a.description">
      <segment state="final">
        <source>An Agent Card lets another agent find this one, delegate a task and collect the result.</source>
        <target>Eine Agent Card lässt andere Agenten diesen finden, Aufgaben delegieren und das Ergebnis abholen.</target>
      </segment>
    </unit>
    <unit id="a2a.console.title">
      <segment state="final">
        <source>Task console</source>
        <target>Task-Konsole</target>
      </segment>
    </unit>
    <unit id="a2a.console.short_description">
      <segment state="final">
        <source>Delegate a task</source>
        <target>Eine Aufgabe delegieren</target>
      </segment>
    </unit>
    <unit id="a2a.console.description">
      <segment state="final">
        <source>Act as a client agent: read the Agent Card, send a message and follow the task.</source>
        <target>Als Client-Agent arbeiten: Agent Card lesen, eine Nachricht senden und den Task verfolgen.</target>
      </segment>
    </unit>
    <unit id="a2a.card.title">
      <segment state="final">
        <source>Agent Card</source>
        <target>Agent Card</target>
      </segment>
    </unit>
    <unit id="a2a.card.short_description">
      <segment state="final">
        <source>Card, skills and interfaces</source>
        <target>Karte, Skills und Schnittstellen</target>
      </segment>
    </unit>
    <unit id="a2a.card.description">
      <segment state="final">
        <source>The published Agent Card: skills, interfaces, capabilities and task states.</source>
        <target>Die veröffentlichte Agent Card: Skills, Schnittstellen, Fähigkeiten und Task-Zustände.</target>
      </segment>
    </unit>
    <unit id="ucp.title">
      <segment state="final">
        <source>UCP</source>
        <target>UCP</target>
      </segment>
    </unit>
    <unit id="ucp.short_description">
      <segment state="final">
        <source>Agent to merchant</source>
        <target>Agent zu Händler</target>
      </segment>
    </unit>
