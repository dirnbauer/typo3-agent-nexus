      <segment state="final">
        <source>Mint and verify mandates</source>
        <target>Mandate erzeugen und prüfen</target>
      </segment>
    </unit>
    <unit id="ap2.studio.description">
      <segment state="final">
        <source>Sign open and closed mandates with sandbox keys and verify the chain.</source>
        <target>Offene und geschlossene Mandate mit Sandbox-Schlüsseln signieren und die Kette prüfen.</target>
      </segment>
    </unit>
