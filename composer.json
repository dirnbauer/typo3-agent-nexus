{
    "name": "webconsulting/agent-nexus",
    "type": "typo3-cms-extension",
    "description": "Agent Nexus - A unified TYPO3 v14 lab for A2UI, AG-UI, A2A, UCP and AP2 agent protocol demos.",
    "keywords": [
        "TYPO3",
        "agent",
        "A2UI",
        "AG-UI",
        "A2A",
        "UCP",
        "AP2",
        "generative-ui",
        "agentic-commerce"
    ],
    "homepage": "https://github.com/dirnbauer/typo3-agent-nexus",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "webconsulting GmbH",
            "email": "office@webconsulting.at",
            "homepage": "https://webconsulting.at",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/dirnbauer/typo3-agent-nexus/issues",
        "source": "https://github.com/dirnbauer/typo3-agent-nexus"
    },
    "require": {
        "php": "^8.4",
        "ext-openssl": "*",
        "typo3/cms-backend": "^14.3.7",
        "typo3/cms-core": "^14.3.7",
        "typo3/cms-extbase": "^14.3.7",
        "typo3/cms-fluid": "^14.3.7",
        "typo3/cms-fluid-styled-content": "^14.3.7",
        "typo3/cms-frontend": "^14.3.7"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "opis/json-schema": "^2.6",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2.15",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^13.3",
        "saschaegerer/phpstan-typo3": "^3.1",
        "typo3/coding-standards": "^0.9",
        "typo3/testing-framework": "^9.7"
    },
    "suggest": {
        "netresearch/nr-llm": "Lets the frontend widgets use a real language model (A2UI surfaces, AG-UI answers, A2A routing, UCP rationale). Without it every protocol runs its deterministic demo.",
        "typo3/cms-scheduler": "Runs agentnexus:cleanup on a schedule through the \"Execute console commands\" task, which applies the traffic and object retention settings."
    },
    "autoload": {
        "psr-4": {
            "Webconsulting\\AgentNexus\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webconsulting\\AgentNexus\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "vendor-dir": ".Build/vendor"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "agent_nexus",
            "web-dir": ".Build/Web",
            "version": "4.0.3",
            "Package": {
                "providesPackages": {}
            }
        }
    },
    "scripts": {
        "ci": [
            "@ci:cgl",
            "@ci:phpstan",
            "@ci:tests:unit",
            "@ci:tests:functional"
        ],
        "ci:cgl": "php-cs-fixer fix --config .php-cs-fixer.dist.php --diff --dry-run --using-cache no",
        "ci:php:lint": "find Classes Configuration Tests ext_localconf.php -name '*.php' -print0 | xargs -0 -n1 -P4 php -l >/dev/null",
        "ci:phpstan": "phpstan analyse --configuration phpstan.neon --no-progress",
        "ci:tests:functional": "phpunit -c Build/phpunit/FunctionalTests.xml",
        "ci:tests:unit": "phpunit -c Build/phpunit/UnitTests.xml",
        "fix:cgl": "php-cs-fixer fix --config .php-cs-fixer.dist.php"
    }
}
