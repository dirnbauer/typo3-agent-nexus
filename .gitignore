# Build output — this extension builds standalone into .Build for CI and tests.
/.Build/
/var/
/vendor/
/node_modules/

# Resolved dependencies. Agent Nexus is a library: the lock file belongs to the
# project that installs it, not here.
composer.lock

# Archify checkout used by `npm run diagrams` (pinned in Build/render-diagrams.mjs).
/Build/.archify/

# Tool caches
/.php-cs-fixer.cache
/.phpunit.cache/
.phpunit.result.cache
/.phpstan.cache/

# Editors and operating systems
.DS_Store
.idea/
.vscode/
*.swp
