parameters:
    level: 8
    scanFiles:
        # netresearch/nr-llm is a soft dependency; see the stub file's header.
        - Build/phpstan/stubs/nr-llm.php
    phpVersion: 80400
    paths:
        - Classes
        - Configuration
        - Tests
        - ext_localconf.php
    excludePaths:
        analyseAndScan:
            - .Build
            - Resources
            - var
    tmpDir: var/phpstan
    treatPhpDocTypesAsCertain: false
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    checkUninitializedProperties: true
    reportUnmatchedIgnoredErrors: true
    ignoreErrors:
        # Agent Nexus marks its services final, which is right for production
        # code and something PHPUnit cannot double. Build/phpunit/UnitTestsBootstrap.php
        # loads dg/bypass-finals so createMock() works at runtime; PHPStan cannot
        # see that, and reports the doubled type as unresolvable.
        -
            identifier: method.unresolvableReturnType
            path: Tests/Unit/*
