parameters:
    level: 8
    scanFiles:
        # netresearch/nr-llm is a soft dependency; see the stub file's header.
        - Build/phpstan/stubs/nr-llm.php
    phpVersion: 80400
    paths:
        - Classes
        - Configuration
        - Tests
        - ext_localconf.php
    excludePaths:
        analyseAndScan:
            - .Build
            - Resources
            - var
    tmpDir: var/phpstan
    treatPhpDocTypesAsCertain: false
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    checkUninitializedProperties: true
    reportUnmatchedIgnoredErrors: true
    typo3:
        requestGetAttributeMapping:
            # Backend routing puts the matched route on every backend request.
            route: TYPO3\CMS\Backend\Routing\Route
            # Set by Shared\Http\Api\ApiRouter on every request it serves.
            agentnexus.route: Webconsulting\AgentNexus\Shared\Http\Api\RouteMatch
            agentnexus.traffic: Webconsulting\AgentNexus\Shared\Traffic\TrafficCapture
