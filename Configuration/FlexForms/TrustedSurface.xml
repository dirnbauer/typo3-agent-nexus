<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Signed Quote Authorization</sheetTitle>
                <type>array</type>
                <el>
                    <settings.intro>
                        <label>Intro text</label>
                        <description>Shown above the trusted surface.</description>
                        <config>
                            <type>text</type>
                            <cols>48</cols>
                            <rows>3</rows>
                            <default>See how an agent purchase is authorized: a signed Intent Mandate sets your limits, a Cart Mandate locks the exact order, and the chain is verified before any payment. Sandbox demo — nothing is charged.</default>
                        </config>
                    </settings.intro>
                    <settings.accent>
                        <label>Accent token</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>ap2</default>
                            <items>
                                <numIndex index="0">
                                    <label>AP2 protocol accent</label>
                                    <value>ap2</value>
                                </numIndex>
                                <numIndex index="1">
                                    <label>Theme primary</label>
                                    <value>primary</value>
                                </numIndex>
                                <numIndex index="2">
                                    <label>Theme accent</label>
                                    <value>accent</value>
                                </numIndex>
                                <numIndex index="3">
                                    <label>Theme secondary</label>
                                    <value>secondary</value>
                                </numIndex>
                                <numIndex index="4">
                                    <label>Theme destructive</label>
                                    <value>destructive</value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.accent>
                    <settings.show_events>
                        <label>Show the signed mandates</label>
                        <description>Reveals the issued Intent + Cart Mandate tokens (JWS) under the result. Great for explaining the protocol.</description>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                            <items>
                                <numIndex index="0">
                                    <label></label>
                                    <value></value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.show_events>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
