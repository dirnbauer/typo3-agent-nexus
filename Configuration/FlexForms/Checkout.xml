<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>Package &amp; Quote Builder</sheetTitle>
                <type>array</type>
                <el>
                    <settings.intro>
                        <label>Intro text</label>
                        <description>Shown above the agent checkout.</description>
                        <config>
                            <type>text</type>
                            <cols>48</cols>
                            <rows>3</rows>
                            <default>Tell our shopping agent what you need. It reads the catalog, builds a cart and — before anything is charged — pauses for your authorization. Every order here is simulated.</default>
                        </config>
                    </settings.intro>
                    <settings.accent>
                        <label>Accent token</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>ucp</default>
                            <items>
                                <numIndex index="0">
                                    <label>UCP protocol accent</label>
                                    <value>ucp</value>
                                </numIndex>
                                <numIndex index="1">
                                    <label>Theme primary</label>
                                    <value>primary</value>
                                </numIndex>
                                <numIndex index="2">
                                    <label>Theme accent</label>
                                    <value>accent</value>
                                </numIndex>
                                <numIndex index="3">
                                    <label>Theme secondary</label>
                                    <value>secondary</value>
                                </numIndex>
                                <numIndex index="4">
                                    <label>Theme destructive</label>
                                    <value>destructive</value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.accent>
                    <settings.show_events>
                        <label>Show the commerce events</label>
                        <description>Reveals an "under the hood" panel listing the UCP events as they arrive. Turn off for a clean production look.</description>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                            <items>
                                <numIndex index="0">
                                    <label></label>
                                    <value></value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.show_events>
                    <settings.use_llm>
                        <label>Model-written recommendation rationale</label>
                        <description>The shopping agent's reasoning text is written by a real model (via nr-llm), grounded in the fixed cart. Cart contents and prices always stay deterministic. Global switch, budget and rate limits still apply.</description>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                            <items>
                                <numIndex index="0">
                                    <label></label>
                                </numIndex>
                            </items>
                        </config>
                    </settings.use_llm>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
