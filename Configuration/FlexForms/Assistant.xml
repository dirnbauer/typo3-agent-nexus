<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>AI Site Assistant</sheetTitle>
                <type>array</type>
                <el>
                    <settings.intro>
                        <label>Intro text</label>
                        <description>Shown above the assistant. Invite the visitor to state their goal.</description>
                        <config>
                            <type>text</type>
                            <cols>48</cols>
                            <rows>3</rows>
                            <default>Tell our assistant what you are looking for. It thinks out loud, shows you options, and never captures anything without your go-ahead.</default>
                        </config>
                    </settings.intro>
                    <settings.placeholder>
                        <label>Input placeholder</label>
                        <config>
                            <type>input</type>
                            <default>e.g. "I need a plan for a team of five, under €50 a month"</default>
                        </config>
                    </settings.placeholder>
                    <settings.scenario>
                        <label>Assistant scenario</label>
                        <description>Which scripted agent run the demo plays. Both end with a human-in-the-loop approval before any lead is captured.</description>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>plan</default>
                            <items>
                                <numIndex index="0">
                                    <label>Plan advisor (recommends a plan, then confirms)</label>
                                    <value>plan</value>
                                </numIndex>
                                <numIndex index="1">
                                    <label>Consultation booking (gathers details, then confirms)</label>
                                    <value>support</value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.scenario>
                    <settings.presets>
                        <label>Quick-start prompts (one per line)</label>
                        <description>Optional chips shown under the input.</description>
                        <config>
                            <type>text</type>
                            <cols>48</cols>
                            <rows>3</rows>
                            <default>Recommend a plan for my team
Book an introductory call
Which plan scales with us?</default>
                        </config>
                    </settings.presets>
                    <settings.success_message>
                        <label>Success message</label>
                        <config>
                            <type>text</type>
                            <cols>48</cols>
                            <rows>2</rows>
                            <default>Thank you — your request is on its way to our team. We will be in touch shortly.</default>
                        </config>
                    </settings.success_message>
                    <settings.accent>
                        <label>Accent token</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <default>agui</default>
                            <items>
                                <numIndex index="0">
                                    <label>AG-UI protocol accent</label>
                                    <value>agui</value>
                                </numIndex>
                                <numIndex index="1">
                                    <label>Theme primary</label>
                                    <value>primary</value>
                                </numIndex>
                                <numIndex index="2">
                                    <label>Theme accent</label>
                                    <value>accent</value>
                                </numIndex>
                                <numIndex index="3">
                                    <label>Theme secondary</label>
                                    <value>secondary</value>
                                </numIndex>
                                <numIndex index="4">
                                    <label>Theme destructive</label>
                                    <value>destructive</value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.accent>
                    <settings.show_events>
                        <label>Show the live event stream</label>
                        <description>Reveals a small "under the hood" panel listing the AG-UI events as they arrive — great for explaining the protocol. Turn off for a clean production look.</description>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                            <items>
                                <numIndex index="0">
                                    <label></label>
                                </numIndex>
                            </items>
                        </config>
                    </settings.show_events>
                    <settings.use_llm>
                        <label>Answer with the real model</label>
                        <description>When the visitor types a question, stream a real LLM answer (via nr-llm) instead of the scripted draft. The approval gate and lead capture stay scripted either way. Global switch, budget and rate limits still apply.</description>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                            <items>
                                <numIndex index="0">
                                    <label></label>
                                </numIndex>
                            </items>
                        </config>
                    </settings.use_llm>
                    <settings.llm_system_prompt>
                        <label>System prompt override</label>
                        <description>Optional. Replaces the built-in scenario prompt for model answers. Loaded server-side — visitors cannot see or change it.</description>
                        <config>
                            <type>text</type>
                            <cols>48</cols>
                            <rows>4</rows>
                            <default></default>
                        </config>
                    </settings.llm_system_prompt>
                    <settings.llm_max_tokens>
                        <label>Max answer tokens</label>
                        <description>Upper bound for one model answer. The extension-wide ceiling always wins. 0 = use the ceiling.</description>
                        <config>
                            <type>number</type>
                            <default>400</default>
                        </config>
                    </settings.llm_max_tokens>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
