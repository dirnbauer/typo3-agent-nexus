# Legacy CTypes from the five per-protocol packages Agent Nexus replaced.
# Deprecated since 3.0 and removed in 4.0 — run the "Agent Nexus: migrate legacy
# content element types" upgrade wizard to rewrite existing records.
tt_content.a2uiintegration_inquiry =< tt_content.agentnexus_inquiry
tt_content.aguiintegration_assistant =< tt_content.agentnexus_assistant
tt_content.a2aintegration_concierge =< tt_content.agentnexus_concierge
tt_content.ucpintegration_checkout =< tt_content.agentnexus_checkout
tt_content.ap2integration_trustedsurface =< tt_content.agentnexus_trustedsurface
