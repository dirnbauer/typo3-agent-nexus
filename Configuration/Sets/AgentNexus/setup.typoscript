# Agent Nexus — frontend rendering glue.
#
# Every Agent Nexus content element is an Extbase plugin wrapped in the site's
# own content-element frame (lib.contentElement), so a protocol demo sits in a
# page like any other element: it gets the standard header, spacing and frame,
# and the plugin output is the cObj "20".
#
# This set is deliberately design-system agnostic — it only needs
# fluid_styled_content. The widgets take their neutrals from the host theme's
# shadcn variables (see Resources/Public/Css/nexus-tokens.css), so a Desiderio
# site needs nothing extra.

lib.contentElement.templateRootPaths.1750 = EXT:agent_nexus/Resources/Private/ContentElements/Templates/

plugin.tx_agentnexus {
    view {
        templateRootPaths.10 = EXT:agent_nexus/Resources/Private/Templates/
        partialRootPaths.10 = EXT:agent_nexus/Resources/Private/Partials/
        layoutRootPaths.10 = EXT:agent_nexus/Resources/Private/Layouts/
    }
    persistence {
        storagePid = {$agentNexus.storagePid}
    }
    settings {
        storagePid = {$agentNexus.storagePid}
        showProtocolInfo = {$agentNexus.showProtocolInfo}
    }
}

# Each element references lib.contentElement rather than copying it, and each
# one does so directly. An intermediate "lib.agentNexusPlugin =< lib.contentElement"
# would read better and does not work: TypoScript resolves "=<" at render time,
# and a reference pointing at another reference resolves to nothing — every
# plugin rendered an empty content frame. A copy ("<") would resolve, but it
# would be taken here, before the sets that depend on this one have finished
# configuring lib.contentElement, so the plugins would silently stop following
# the site's own content frame.

tt_content.agentnexus_hub =< lib.contentElement
tt_content.agentnexus_hub {
    templateName = AgentNexusPlugin
    20 = EXTBASEPLUGIN
    20 {
        extensionName = AgentNexus
        pluginName = Hub
    }
}

tt_content.agentnexus_inquiry =< lib.contentElement
tt_content.agentnexus_inquiry {
    templateName = AgentNexusPlugin
    20 = EXTBASEPLUGIN
    20 {
        extensionName = AgentNexus
        pluginName = Inquiry
    }
}

tt_content.agentnexus_assistant =< lib.contentElement
tt_content.agentnexus_assistant {
    templateName = AgentNexusPlugin
    20 = EXTBASEPLUGIN
    20 {
        extensionName = AgentNexus
        pluginName = Assistant
    }
}

tt_content.agentnexus_concierge =< lib.contentElement
tt_content.agentnexus_concierge {
    templateName = AgentNexusPlugin
    20 = EXTBASEPLUGIN
    20 {
        extensionName = AgentNexus
        pluginName = Concierge
    }
