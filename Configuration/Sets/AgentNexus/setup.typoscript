tt_content.agentnexus_protocolinfo =< lib.contentElement
tt_content.agentnexus_protocolinfo {
    templateName = AgentNexusPlugin
    20 = EXTBASEPLUGIN
    20 {
        extensionName = AgentNexus
        pluginName = ProtocolInfo
    }
}
