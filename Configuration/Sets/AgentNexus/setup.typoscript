tt_content.agentnexus_checkout =< lib.contentElement
tt_content.agentnexus_checkout {
    templateName = AgentNexusPlugin
    20 = EXTBASEPLUGIN
    20 {
        extensionName = AgentNexus
        pluginName = Checkout
    }
